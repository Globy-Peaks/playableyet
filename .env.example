# Optional. Raises the GitHub API rate limit used by shadPS4, SharpEmu, and KytyPS5.
GITHUB_TOKEN=

# Optional. Confirmation and "now playable" mail. The watch form still stores signups when this is empty.
RESEND_API_KEY=
# Optional sender. Defaults to Resend's onboarding address.
RESEND_FROM=

# Required in production. /api/cron/sync rejects the request unless
# Authorization is "Bearer <secret>". Unset is allowed only for local next dev.
CRON_SECRET=

# Optional. Lets the daily cron publish the public catalog on Vercel.
# Without it, the site serves data/catalog.json.
BLOB_READ_WRITE_TOKEN=

# Optional. Token for a private Blob store used only for watchlist emails and tokens.
# When unset, the watchlist uses BLOB_READ_WRITE_TOKEN.
WATCHLIST_BLOB_READ_WRITE_TOKEN=

# Optional. Stable secret for the unguessable watchlist pathname. Set this before
# rotating Blob tokens. When unset, the pathname is derived from the token above.
WATCHLIST_BLOB_SECRET=

# Canonical origin used in emails, sitemap, and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123
