# Optional. Raises the GitHub API rate limit used by shadPS4, SharpEmu, and KytyPS5.
GITHUB_TOKEN=

# Sending-only key. Watchlist mail, and the weekly digest confirmation and welcome mail.
# Contacts, topics, and properties need RESEND_CONTACTS_API_KEY instead.
RESEND_API_KEY=
# Required for newsletter mail. Example: PlayableYet <hello@globypeaks.com>
RESEND_FROM=

# Full-access Resend key for contacts, topic subscriptions, and contact properties.
# When unset, the digest form stays up but confirm does not add a subscriber.
RESEND_CONTACTS_API_KEY=
# Topic "PlayableYet weekly" (default opt-out). Override only if you recreate it.
RESEND_NEWSLETTER_TOPIC_ID=
# Segment used so a topic-filtered broadcast can reach these contacts.
# Defaults to General. PatchVerdict Newsletter and Sponsor Inquiries are refused.
RESEND_NEWSLETTER_SEGMENT_ID=
# HMAC secret for unsubscribe links. Not an API key. Required before confirm adds anyone.
NEWSLETTER_UNSUBSCRIBE_SECRET=

# Required in production. /api/cron/sync rejects the request unless
# Authorization is "Bearer <secret>". Unset is allowed only for local next dev.
CRON_SECRET=

# Optional. Lets the daily cron publish the public catalog on Vercel.
# Without it, the site serves data/catalog.json.
BLOB_READ_WRITE_TOKEN=

# Optional. Token for a private Blob store used only for watchlist emails and tokens.
# When unset, the watchlist uses BLOB_READ_WRITE_TOKEN.
WATCHLIST_BLOB_READ_WRITE_TOKEN=

# Optional. Stable secret for the unguessable watchlist pathname. Set this before
# rotating Blob tokens. When unset, the pathname is derived from the token above.
WATCHLIST_BLOB_SECRET=

# Canonical origin used in emails, sitemap, and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123
